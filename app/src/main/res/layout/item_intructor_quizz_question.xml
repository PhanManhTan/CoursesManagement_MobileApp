<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_panel_basic"
    android:orientation="vertical"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvQuizIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/question_label"
            android:textAppearance="@style/TextAppearance.App.Label.Accent" />

        <TextView
            android:id="@+id/btnRemoveQuiz"
            android:layout_width="72dp"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/delete"
            android:textAppearance="@style/TextAppearance.App.Action.Danger" />
    </RelativeLayout>

    <EditText
        android:id="@+id/etQuestionContent"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_input_square"
        android:hint="@string/quiz_question_hint"
        android:paddingHorizontal="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/rgAnswers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbA"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:buttonTint="@color/accent_light" />

            <EditText
                android:id="@+id/etAnswerA"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_square"
                android:hint="@string/answer_a_hint"
                android:paddingHorizontal="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbB"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:buttonTint="@color/accent_light" />

            <EditText
                android:id="@+id/etAnswerB"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_square"
                android:hint="@string/answer_b_hint"
                android:paddingHorizontal="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbC"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:buttonTint="@color/accent_light" />

            <EditText
                android:id="@+id/etAnswerC"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_square"
                android:hint="@string/answer_c_hint"
                android:paddingHorizontal="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbD"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:buttonTint="@color/accent_light" />

            <EditText
                android:id="@+id/etAnswerD"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_square"
                android:hint="@string/answer_d_hint"
                android:paddingHorizontal="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp" />
        </LinearLayout>
    </RadioGroup>
</LinearLayout>
